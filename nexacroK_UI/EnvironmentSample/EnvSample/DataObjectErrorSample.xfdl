<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="DataObjectErrorSample" width="1280" height="670" onload="DataObjectErrorSample_onload">
    <Layouts>
      <Layout height="670" width="1280">
        <Static id="stc_title" taborder="0" text="06. DataObject onerror 우선순위" left="10" top="10" width="700" height="28" font="bold 14 'Malgun Gothic'" forecolor="#1a56db"/>
        <Static id="stc_desc" taborder="1" text="Environment.md 'onerror' 항목: 이 이벤트 핸들러가 true를 반환하면 DataObject의 onerror는 발생하지 않고 통신 상태를 유지하며, false(기본값)를 반환하면 DataObject의 onerror가 발생하고 통신이 중지됩니다. 아래에서 실제 순서를 로그로 확인합니다." left="10" top="44" width="1240" height="36" forecolor="#555555"/>

        <Static id="stc_return_lbl" taborder="2" text="Environment.onerror 핸들러 반환값" left="10" top="88" width="230" height="26" font="bold 12 'Malgun Gothic'"/>
        <Radio id="rad_return" taborder="3" left="250" top="86" width="260" height="30"/>

        <Button id="btn_register" taborder="4" text="① DataObject + 핸들러 등록" left="10" top="126" width="200" height="32" onclick="btn_register_onclick"/>
        <Button id="btn_request"  taborder="5" text="② 잘못된 URL로 요청 (에러 유발)" left="220" top="126" width="240" height="32" onclick="btn_request_onclick"/>
        <Button id="btn_unregister" taborder="6" text="Environment.onerror 핸들러 해제" left="470" top="126" width="240" height="32" onclick="btn_unregister_onclick"/>

        <Static id="stc_status" taborder="7" text="" left="10" top="166" width="1240" height="22" forecolor="#cc0000"/>

        <Static id="stc_log_lbl" taborder="8" text="▼ 실행 로그 (발생 순서 그대로 기록)" left="10" top="196" width="300" height="20" forecolor="#888888"/>
        <TextArea id="txa_log" taborder="9" left="10" top="220" width="1240" height="420" readonly="true"/>
      </Layout>
    </Layouts>
    <Objects>
      <Dataset id="ds_returnOption">
        <ColumnInfo>
          <Column id="CODE" type="string" size="10"/>
          <Column id="NAME" type="string" size="60"/>
        </ColumnInfo>
        <Rows>
          <Row><Col id="CODE">false</Col><Col id="NAME">false (기본값) — DataObject.onerror 도 발생시킴</Col></Row>
          <Row><Col id="CODE">true</Col><Col id="NAME">true — DataObject.onerror 를 막고 통신 상태 유지</Col></Row>
        </Rows>
      </Dataset>
    </Objects>
    <Script type="xscript5.1"><![CDATA[
// this.bCreated, this.nSeq (Form 속성) 으로 관리 — var 클로저 변수 사용 금지

this.DataObjectErrorSample_onload = function(obj, e)
{
    this.bCreated = false;
    this.nSeq     = 0;

    this.rad_return.set_innerdataset("ds_returnOption");
    this.rad_return.set_codecolumn("CODE");
    this.rad_return.set_datacolumn("NAME");
    this.rad_return.set_value("false");

    // Environment.onerror 전역 핸들러 등록 (이 화면에서 나가기 전에는 [핸들러 해제]로 반드시 정리하세요)
    nexacro.getEnvironment().addEventHandler("onerror", this.env_onerror, this);

    this.txa_log.set_value("");
    this.fn_log("Environment.onerror 핸들러 등록 완료. ① → ② 순서로 버튼을 눌러보세요.");
};

this.fn_log = function(sMsg)
{
    this.nSeq++;
    this.txa_log.set_value(this.txa_log.value + "[" + this.nSeq + "] " + sMsg + "\n");
};

// ────── ① DataObject 동적 생성 + 개별 onerror 등록 ──────────────────
this.btn_register_onclick = function(obj, e)
{
    if (this.bCreated) { this.stc_status.set_text("이미 생성되어 있습니다."); return; }

    var dobj = new nexacro.DataObject("dobj_err", this);
    this.addChild("dobj_err", dobj);
    dobj.addEventHandler("onerror", this.dobj_err_onerror, this);

    this.bCreated = true;
    this.stc_status.set_text("✔ DataObject + 개별 onerror 핸들러 등록 완료.");
    this.fn_log("DataObject(dobj_err) 생성 + 개별 onerror 핸들러 등록");
};

// ────── ② 존재하지 않는 도메인으로 요청 → 통신 에러 유발 ──────────────
this.btn_request_onclick = function(obj, e)
{
    var dobj = this["dobj_err"];
    if (!dobj) { this.stc_status.set_text("먼저 ① DataObject를 생성하세요."); return; }

    this.fn_log("요청 시작: GET https://invalid.nexacro-env-sample.test/notfound (반환값 설정=" + this.rad_return.value + ")");
    dobj.request("BAD_REQ", "GET", "https://invalid.nexacro-env-sample.test/notfound");
};

// ────── Environment 전역 onerror: 반환값에 따라 DataObject.onerror 발생 여부가 바뀜 ──
this.env_onerror = function(obj, e)
{
    var bReturnTrue = (this.rad_return.value == "true");
    this.fn_log("Environment.onerror 발생! (obj=" + obj + ") → 이 핸들러가 " + bReturnTrue + " 를 반환합니다.");
    return bReturnTrue;
};

// ────── DataObject 개별 onerror: Environment.onerror가 true를 반환하면 이 핸들러는 호출되지 않아야 함 ──
this.dobj_err_onerror = function(obj, e)
{
    this.fn_log("DataObject(dobj_err).onerror 발생! statuscode=" + e.statuscode + " / errormsg=" + e.errormsg);
    this.stc_status.set_text("DataObject.onerror 까지 도달했습니다 (Environment.onerror가 false를 반환한 경우).");
};

this.btn_unregister_onclick = function(obj, e)
{
    nexacro.getEnvironment().removeEventHandler("onerror", this.env_onerror);
    this.fn_log("Environment.onerror 핸들러 해제 완료 (다른 화면으로 이동하기 전 정리).");
    this.stc_status.set_text("Environment.onerror 핸들러를 해제했습니다.");
};
    ]]></Script>
  </Form>
</FDL>
