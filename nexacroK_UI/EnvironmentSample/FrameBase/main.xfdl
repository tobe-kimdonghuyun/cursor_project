<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="main" width="1280" height="760" onload="main_onload">
    <Layouts>
      <Layout height="760" width="1280">
        <Static id="stc_title" taborder="0" text="Environment / nexacro 객체 상속 샘플" left="10" top="10" width="700" height="32" font="bold 16 'Malgun Gothic'"/>
        <Static id="stc_label" taborder="1" text="화면 선택:" left="10" top="55" width="70" height="28"/>
        <Combo id="cmb_menu" taborder="2" left="85" top="52" width="420" height="32" innerdataset="dsMenu" codecolumn="CODE" datacolumn="NAME" onitemchanged="cmb_menu_onitemchanged"/>
        <Static id="stc_desc" taborder="3" text="" left="520" top="58" width="740" height="24" forecolor="#666666"/>
        <Div id="div_content" left="0" top="90" width="1280" height="670"/>
      </Layout>
    </Layouts>
    <Objects>
      <Dataset id="dsMenu">
        <ColumnInfo>
          <Column id="CODE" type="string" size="10"/>
          <Column id="NAME" type="string" size="60"/>
          <Column id="URL" type="string" size="100"/>
          <Column id="DESC" type="string" size="200"/>
        </ColumnInfo>
        <Rows>
          <Row><Col id="CODE">ENV</Col><Col id="NAME">01. Environment 기본 조회/변경</Col><Col id="URL">EnvSample::EnvironmentSample.xfdl</Col><Col id="DESC">nexacro.getEnvironment() 로 locale/usewaitcursor/enableclipboard/loglevel 조회 및 런타임 변경 데모</Col></Row>
          <Row><Col id="CODE">CAL</Col><Col id="NAME">02. Calendar × Environment 상속</Col><Col id="URL">EnvSample::CalendarInheritSample.xfdl</Col><Col id="DESC">calendarrestoreonblur / usedateautocalibration — Studio 전용 속성이 Calendar 동작에 미치는 영향 확인</Col></Row>
          <Row><Col id="CODE">VF</Col><Col id="NAME">03. VirtualFile × filesecurelevel</Col><Col id="URL">EnvSample::VirtualFileSecureSample.xfdl</Col><Col id="DESC">filesecurelevel 값에 따라 VirtualFile의 로컬 파일 접근 허용 범위가 어떻게 달라지는지 확인 (NRE 전용)</Col></Row>
          <Row><Col id="CODE">DS</Col><Col id="NAME">04. Dataset × Environment 상속(fallback)</Col><Col id="URL">EnvSample::DatasetInheritSample.xfdl</Col><Col id="DESC">datasetsaveinfinity/datasetsavenan — Dataset 개별 속성 미설정 시 Environment 값으로 fallback되는 구조 실증</Col></Row>
          <Row><Col id="CODE">VAR</Col><Col id="NAME">05. Environment 변수 vs Application 변수</Col><Col id="URL">EnvSample::EnvVsAppVariableSample.xfdl</Col><Col id="DESC">nexacro.setEnvironmentVariable() 와 application.setGlobal() 이 서로 다른 저장소임을 비교 실증</Col></Row>
          <Row><Col id="CODE">ERR</Col><Col id="NAME">06. DataObject onerror 우선순위</Col><Col id="URL">EnvSample::DataObjectErrorSample.xfdl</Col><Col id="DESC">DataObject 개별 onerror 핸들러와 Environment 전역 onerror 이벤트의 발생 순서/우선순위 비교</Col></Row>
        </Rows>
      </Dataset>
    </Objects>
    <Script type="xscript5.1"><![CDATA[
this.main_onload = function(obj, e)
{
    if (this.dsMenu.rowcount > 0)
    {
        this.cmb_menu.set_value(this.dsMenu.getColumn(0, "CODE"));
        this.stc_desc.set_text(this.dsMenu.getColumn(0, "DESC"));
        this.div_content.set_url(this.dsMenu.getColumn(0, "URL"));
    }
};

this.cmb_menu_onitemchanged = function(obj, e)
{
    var nRow = this.dsMenu.findRow("CODE", obj.value);
    if (nRow >= 0)
    {
        this.stc_desc.set_text(this.dsMenu.getColumn(nRow, "DESC"));
        this.div_content.set_url(this.dsMenu.getColumn(nRow, "URL"));
    }
};
    ]]></Script>
  </Form>
</FDL>
