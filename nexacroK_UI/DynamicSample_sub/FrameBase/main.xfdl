<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="main_sub" width="1280" height="760" onload="main_sub_onload">
    <Layouts>
      <Layout height="760" width="1280">
        <Static id="stc_title" taborder="0" text="넥사크로 동적 컴포넌트 생성 샘플" left="10" top="10" width="700" height="32" font="bold 16 'Malgun Gothic'"/>
        <Static id="stc_label" taborder="1" text="화면 선택:" left="10" top="55" width="70" height="28"/>
        <Combo id="cmb_menu" taborder="2" left="85" top="52" width="380" height="32" innerdataset="dsMenu" codecolumn="CODE" datacolumn="NAME" onitemchanged="cmb_menu_onitemchanged"/>
        <Static id="stc_desc" taborder="3" text="" left="480" top="58" width="780" height="24" color="#666666"/>
        <Div id="div_content" left="0" top="90" width="1280" height="670"/>
      </Layout>
    </Layouts>
    <Objects>
      <Dataset id="dsMenu">
        <ColumnInfo>
          <Column id="CODE" type="string" size="10"/>
          <Column id="NAME" type="string" size="60"/>
          <Column id="URL" type="string" size="100"/>
          <Column id="DESC" type="string" size="200"/>
        </ColumnInfo>
        <Rows>
          <Row><Col id="CODE">BTN</Col><Col id="NAME">[가시적] Button 동적 생성</Col><Col id="URL">VisibleComp::ButtonSample.xfdl</Col><Col id="DESC">new nexacro.Button() — 버튼을 동적으로 생성하고 이벤트를 연결합니다</Col></Row>
          <Row><Col id="CODE">EDT</Col><Col id="NAME">[가시적] Edit 동적 생성</Col><Col id="URL">VisibleComp::EditSample.xfdl</Col><Col id="DESC">new nexacro.Edit() — Edit/MaskEdit을 동적으로 생성합니다</Col></Row>
          <Row><Col id="CODE">GRD</Col><Col id="NAME">[가시적] Grid 동적 생성</Col><Col id="URL">VisibleComp::GridSample.xfdl</Col><Col id="DESC">new nexacro.Grid() — Grid와 Dataset을 동적으로 생성하고 바인딩합니다</Col></Row>
          <Row><Col id="CODE">CMB</Col><Col id="NAME">[가시적] Combo 동적 생성</Col><Col id="URL">VisibleComp::ComboSample.xfdl</Col><Col id="DESC">new nexacro.Combo() — Combo와 이너 Dataset을 동적으로 생성합니다</Col></Row>
          <Row><Col id="CODE">CHK</Col><Col id="NAME">[가시적] CheckBox 동적 생성</Col><Col id="URL">VisibleComp::CheckBoxSample.xfdl</Col><Col id="DESC">new nexacro.CheckBox() — CheckBox를 다양한 옵션으로 동적 생성합니다</Col></Row>
          <Row><Col id="CODE">RAD</Col><Col id="NAME">[가시적] Radio 동적 생성</Col><Col id="URL">VisibleComp::RadioSample.xfdl</Col><Col id="DESC">new nexacro.Radio() — Radio를 innerdataset과 함께 동적으로 생성합니다</Col></Row>
          <Row><Col id="CODE">TAB</Col><Col id="NAME">[가시적] Tab 동적 생성</Col><Col id="URL">VisibleComp::TabSample.xfdl</Col><Col id="DESC">new nexacro.Tab() — Tab과 TabPage를 동적으로 생성/추가합니다</Col></Row>
          <Row><Col id="CODE">STC</Col><Col id="NAME">[가시적] Static 동적 생성</Col><Col id="URL">VisibleComp::StaticSample.xfdl</Col><Col id="DESC">new nexacro.Static() — Static을 다양한 스타일로 동적 생성합니다</Col></Row>
          <Row><Col id="CODE">TXA</Col><Col id="NAME">[가시적] TextArea 동적 생성</Col><Col id="URL">VisibleComp::TextAreaSample.xfdl</Col><Col id="DESC">new nexacro.TextArea() — TextArea를 동적으로 생성합니다</Col></Row>
          <Row><Col id="CODE">LST</Col><Col id="NAME">[가시적] ListBox 동적 생성</Col><Col id="URL">VisibleComp::ListBoxSample.xfdl</Col><Col id="DESC">new nexacro.ListBox() — ListBox와 Dataset을 동적으로 생성합니다</Col></Row>
          <Row><Col id="CODE">CAL</Col><Col id="NAME">[가시적] Calendar 동적 생성</Col><Col id="URL">VisibleComp::CalendarSample.xfdl</Col><Col id="DESC">new nexacro.Calendar() — Calendar를 동적으로 생성하고 날짜 선택 이벤트를 연결합니다</Col></Row>
          <Row><Col id="CODE">MSK</Col><Col id="NAME">[가시적] MaskEdit 동적 생성</Col><Col id="URL">VisibleComp::MaskEditSample.xfdl</Col><Col id="DESC">new nexacro.MaskEdit() — 다양한 format의 MaskEdit을 동적으로 생성합니다</Col></Row>
          <Row><Col id="CODE">DS</Col><Col id="NAME">[비가시적] Dataset 동적 생성</Col><Col id="URL">InvisibleComp::DatasetSample.xfdl</Col><Col id="DESC">new nexacro.Dataset() — Dataset을 동적 생성하고 Grid에 바인딩하여 CRUD를 수행합니다</Col></Row>
          <Row><Col id="CODE">DO</Col><Col id="NAME">[비가시적] DataObject 동적 생성</Col><Col id="URL">InvisibleComp::DataObjectSample.xfdl</Col><Col id="DESC">new nexacro.DataObject() — REST API를 호출하고 결과를 Grid에 표시합니다</Col></Row>
          <Row><Col id="CODE">VF</Col><Col id="NAME">[비가시적] VirtualFile 동적 생성</Col><Col id="URL">InvisibleComp::VirtualFileSample.xfdl</Col><Col id="DESC">new nexacro.VirtualFile() — 파일 드래그앤드롭으로 VirtualFile을 획득하고 정보를 표시합니다</Col></Row>
          <Row><Col id="CODE">TR1</Col><Col id="NAME">[비가시적] transaction — Promise 방식</Col><Col id="URL">InvisibleComp::TransactionSample01.xfdl</Col><Col id="DESC">this.transaction() 반환 Promise에 .then().catch()를 체이닝하여 서버 통신 결과를 처리합니다</Col></Row>
          <Row><Col id="CODE">TR2</Col><Col id="NAME">[비가시적] transaction — async/await 방식</Col><Col id="URL">InvisibleComp::TransactionSample02.xfdl</Col><Col id="DESC">async function에서 await this.transaction()으로 절차적으로 결과를 처리합니다</Col></Row>
        </Rows>
      </Dataset>
    </Objects>
    <Script type="xscript5.1"><![CDATA[
this.main_sub_onload = function(obj, e)
{
    if (this.dsMenu.rowcount > 0)
    {
        this.cmb_menu.set_value(this.dsMenu.getColumn(0, "CODE"));
        this.stc_desc.set_text(this.dsMenu.getColumn(0, "DESC"));
        this.div_content.set_url(this.dsMenu.getColumn(0, "URL"));
    }
};

this.cmb_menu_onitemchanged = function(obj, e)
{
    var nRow = this.dsMenu.findRow("CODE", obj.value);
    if (nRow >= 0)
    {
        this.stc_desc.set_text(this.dsMenu.getColumn(nRow, "DESC"));
        this.div_content.set_url(this.dsMenu.getColumn(nRow, "URL"));
    }
};
    ]]></Script>
  </Form>
</FDL>
